{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "prCreation": "immediate",
  "schedule": ["* 6-10 * * 1"],
  "timezone": "Europe/London",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": [],
    "labels": ["security", "urgent"]
  },
  "packageRules": [
    {
      "matchFileNames": ["mise.toml"],
      "matchDepNames": ["java"],
      "enabled": false
    }
  ]
}
