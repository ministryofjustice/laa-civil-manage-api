{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Mock Access Data Store — Drafts",
      "description": "Mock of the Access Data Store endpoints that store form drafts."
    },
    {
      "name": "Prior Authority",
      "description": "Create, update and submit prior-authority requests to the Legal Aid Agency, via a create-draft -\u003e update-draft -\u003e upload-documents -\u003e submit lifecycle."
    }
  ],
  "paths": {
    "/prior-authorities/{priorAuthorityId}": {
      "get": {
        "tags": [
          "Prior Authority"
        ],
        "summary": "Retrieve an existing prior-authority request (draft or submitted)",
        "operationId": "getPriorAuthority",
        "parameters": [
          {
            "name": "priorAuthorityId",
            "in": "path",
            "description": "ID of the prior authority to return.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prior authority returned.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PriorAuthorityResponse"
                }
              }
            }
          },
          "404": {
            "description": "Prior authority not found."
          }
        }
      },
      "put": {
        "tags": [
          "Prior Authority"
        ],
        "summary": "Update an existing prior-authority draft",
        "operationId": "updateDraft",
        "parameters": [
          {
            "name": "priorAuthorityId",
            "in": "path",
            "description": "ID of the prior authority to update.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorAuthorityDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Draft updated."
          },
          "404": {
            "description": "Prior authority not found."
          }
        }
      }
    },
    "/mock-access-data-store/drafts/{draftId}": {
      "get": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "description": "ID of the draft to query.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft returned.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DraftSummary"
                }
              }
            }
          },
          "404": {
            "description": "Draft not found."
          }
        }
      },
      "put": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "Update a draft in the Access Data Store",
        "operationId": "update",
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "description": "ID of the draft to update.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Draft updated."
          },
          "404": {
            "description": "Draft not found."
          }
        }
      },
      "delete": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "Delete a draft from the Access Data Store",
        "operationId": "delete",
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Draft deleted (or did not exist)."
          }
        }
      }
    },
    "/prior-authorities": {
      "post": {
        "tags": [
          "Prior Authority"
        ],
        "summary": "Create a prior-authority draft",
        "description": "Starts a new prior-authority draft.",
        "operationId": "createDraft",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorAuthorityDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Draft created. Location header contains the prior-authority URL.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PriorAuthorityIdResponse"
                }
              }
            }
          },
          "400": {
            "description": "applicationId missing."
          }
        }
      }
    },
    "/prior-authorities/{priorAuthorityId}/submit": {
      "post": {
        "tags": [
          "Prior Authority"
        ],
        "summary": "Submit an in-progress prior-authority request",
        "description": "Locks the draft and forwards the submission to the Access Data Store for validation.",
        "operationId": "submit",
        "parameters": [
          {
            "name": "priorAuthorityId",
            "in": "path",
            "description": "ID of the prior authority to submit.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Request accepted. Location header contains the submission URL.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PriorAuthorityApplicationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "Not in a submittable state"
          }
        }
      }
    },
    "/prior-authorities/{priorAuthorityId}/documents": {
      "post": {
        "tags": [
          "Prior Authority"
        ],
        "summary": "Upload a supporting document",
        "description": "Accepts a multipart/form-data file upload from the frontend and returns the uploaded filename.",
        "operationId": "uploadDocument",
        "parameters": [
          {
            "name": "priorAuthorityId",
            "in": "path",
            "description": "ID of the prior authority.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "documentType",
            "in": "query",
            "description": "Type of document being uploaded.",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The type of document being uploaded as supporting evidence.",
              "enum": [
                "gateway_evidence",
                "merits_report",
                "statement_of_case",
                "court_application",
                "court_order",
                "expert_report",
                "court_application_or_order",
                "parental_responsibility",
                "local_authority_assessment",
                "grounds_of_appeal",
                "counsel_opinion",
                "judgement",
                "plf_court_order"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "File to upload."
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File accepted.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedDocument"
                }
              }
            }
          },
          "400": {
            "description": "No file supplied or file is empty."
          },
          "413": {
            "description": "File exceeds the configured maximum size."
          },
          "415": {
            "description": "Unsupported file type."
          }
        }
      }
    },
    "/mock-access-data-store/drafts": {
      "get": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "List drafts matching the given keys",
        "operationId": "list",
        "parameters": [
          {
            "name": "sourceSystem",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DraftSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "Create a draft in the Access Data Store",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Draft created.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed."
          }
        }
      }
    },
    "/expertTypes": {
      "get": {
        "tags": [
          "expert-type-controller"
        ],
        "summary": "List the expert types available for a matter type",
        "description": "Sourced from the Legal Framework API. Returns an empty list when the matter type has no associated expert types, including when it is not a recognised matter type code.",
        "operationId": "getExpertTypes",
        "parameters": [
          {
            "name": "matterType",
            "in": "query",
            "description": "Matter type code, e.g. KPBLW",
            "required": false,
            "schema": {
              "type": "string",
              "default": "KPBLW"
            },
            "example": "KPBLW"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/client/{applicationId}": {
      "get": {
        "tags": [
          "client-controller"
        ],
        "operationId": "getClientByApplicationId",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/applications": {
      "get": {
        "tags": [
          "applications-controller"
        ],
        "operationId": "getApplications",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "APPLICATION_GRANTED",
              "description": "The status of an application",
              "enum": [
                "APPLICATION_SUBMITTED",
                "APPLICATION_GRANTED",
                "APPLICATION_REFUSED"
              ]
            }
          },
          {
            "name": "laaReference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "clientFirstName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "clientLastName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/applications/{applicationId}": {
      "get": {
        "tags": [
          "applications-controller"
        ],
        "operationId": "getApplicationById",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationSummary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Apportionment": {
        "type": "object",
        "description": "How the expert\u0027s costs are shared with other parties. Present when costsSharedWithOtherParties is true; omitted when it is false.",
        "properties": {
          "partiesSharingCosts": {
            "type": "integer",
            "format": "int32",
            "description": "Total number of parties sharing the costs, including the client.",
            "example": 4,
            "minimum": 2
          },
          "clientShareAmount": {
            "type": "number",
            "description": "The client\u0027s share of the costs, in GBP.",
            "example": 31.25
          }
        },
        "required": [
          "clientShareAmount",
          "partiesSharingCosts"
        ]
      },
      "CounselDetails": {
        "type": "object",
        "description": "The counsel requested. Required when priorAuthorityType is COUNSEL.",
        "properties": {
          "counselType": {
            "type": "string",
            "description": "Type of counsel being applied for.",
            "enum": [
              "KINGS_COUNSEL_ALONE",
              "TWO_JUNIOR_COUNSEL",
              "KINGS_COUNSEL_AND_JUNIOR_COUNSEL",
              "KINGS_COUNSEL_AND_TWO_JUNIOR_COUNSEL"
            ],
            "example": "KINGS_COUNSEL_ALONE"
          }
        },
        "required": [
          "counselType"
        ]
      },
      "DisbursementDetails": {
        "type": "object",
        "description": "The disbursement requested. Required when priorAuthorityType is DISBURSEMENT.",
        "properties": {
          "disbursementPurpose": {
            "type": "string",
            "description": "What the disbursement is for.",
            "example": "Travel"
          },
          "disbursementAmount": {
            "type": "number",
            "description": "Cost of the disbursement in GBP, exclusive of VAT.",
            "example": 125.5
          }
        },
        "required": [
          "disbursementAmount",
          "disbursementPurpose"
        ]
      },
      "ExpertCosts": {
        "type": "object",
        "description": "What the expert will cost, how they will be billed, and how the costs are shared.",
        "properties": {
          "billingType": {
            "type": "string",
            "description": "Whether the expert is billed hourly or at a flat rate.",
            "enum": [
              "HOURLY",
              "FIXED_RATE"
            ],
            "example": "HOURLY"
          },
          "hourlyRate": {
            "type": "number",
            "description": "Hourly rate in GBP. Required when billingType is HOURLY.",
            "example": 50.0
          },
          "timeRequested": {
            "$ref": "#/components/schemas/TimeRequested",
            "description": "Time requested. Required when billingType is HOURLY."
          },
          "totalAmount": {
            "type": "number",
            "description": "Amount requested in GBP. For HOURLY billing this is hourlyRate x (hours + minutes / 60); for FIXED_RATE it is the flat fee entered by the provider.",
            "example": 125.0
          },
          "costsSharedWithOtherParties": {
            "type": "boolean",
            "description": "Whether the expert\u0027s costs are shared with other parties.",
            "example": true
          },
          "apportionment": {
            "$ref": "#/components/schemas/Apportionment",
            "description": "How the costs are split. Required when costsSharedWithOtherParties is true; omitted when false."
          }
        },
        "required": [
          "billingType",
          "costsSharedWithOtherParties",
          "totalAmount"
        ]
      },
      "ExpertDetails": {
        "type": "object",
        "description": "The expert and what they will cost.",
        "properties": {
          "expertType": {
            "type": "string",
            "description": "The expert type.",
            "example": "Psychologist"
          },
          "expertFullName": {
            "type": "string",
            "description": "Full name of the expert the prior authority is for.",
            "example": "Dr John Doe"
          },
          "expertPostcode": {
            "type": "string",
            "description": "Primary business postcode of the expert, for regional rate mapping.",
            "example": "SW1H 9AJ"
          },
          "expertCosts": {
            "$ref": "#/components/schemas/ExpertCosts"
          }
        },
        "required": [
          "expertCosts",
          "expertFullName",
          "expertPostcode",
          "expertType"
        ]
      },
      "PriorAuthorityDraft": {
        "type": "object",
        "description": "A prior-authority form, saved and updated incrementally through the create/update draft lifecycle before being submitted. At most one of expertDetails, counselDetails or disbursementDetails should be populated, matching priorAuthorityType.",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the application this prior-authority request is associated with.",
            "example": "2a28f60d-fe15-43fe-92c3-5530595d5f51"
          },
          "priorAuthorityType": {
            "type": [
              "string",
              "null"
            ],
            "description": "The category of prior authority being requested.",
            "enum": [
              "EXPERT",
              "COUNSEL",
              "DISBURSEMENT"
            ],
            "example": "EXPERT"
          },
          "justification": {
            "type": [
              "string",
              "null"
            ],
            "description": "Detailed rationale explaining why funding is necessary.",
            "example": "Expert evidence is needed to establish causation."
          },
          "expertDetails": {
            "type": "null",
            "$ref": "#/components/schemas/ExpertDetails",
            "description": "Present when priorAuthorityType is EXPERT."
          },
          "counselDetails": {
            "type": "null",
            "$ref": "#/components/schemas/CounselDetails",
            "description": "Present when priorAuthorityType is COUNSEL."
          },
          "disbursementDetails": {
            "type": "null",
            "$ref": "#/components/schemas/DisbursementDetails",
            "description": "Present when priorAuthorityType is DISBURSEMENT."
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "TimeRequested": {
        "type": "object",
        "description": "The amount of the expert\u0027s time being requested.",
        "properties": {
          "hours": {
            "type": "integer",
            "format": "int32",
            "description": "Whole hours requested.",
            "example": 2,
            "minimum": 0
          },
          "minutes": {
            "type": "integer",
            "format": "int32",
            "description": "Additional minutes requested.",
            "example": 30,
            "maximum": 59,
            "minimum": 0
          }
        },
        "required": [
          "hours",
          "minutes"
        ]
      },
      "Draft": {
        "type": "object",
        "description": "An in-progress draft that the user wants to save and return to later. The draftBody is an unstructured JSON payload owned by the calling system.",
        "properties": {
          "sourceSystem": {
            "type": "string",
            "description": "Identifies the system creating the draft (e.g., laa-civil-manage).",
            "example": "laa-civil-manage",
            "minLength": 1
          },
          "draftType": {
            "type": "string",
            "description": "Identifies the flow the draft belongs to (e.g., PRIOR_AUTHORITY). ",
            "example": "PRIOR_AUTHORITY",
            "minLength": 1
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the application the draft is associated with.",
            "example": "2a28f60d-fe15-43fe-92c3-5530595d5f51"
          },
          "userId": {
            "type": "string",
            "description": "Entra identity of the user who owns the draft.",
            "example": "entra-id-uuid",
            "minLength": 1
          },
          "draftBody": {
            "type": "object",
            "additionalProperties": {},
            "description": "JSON payload representing the in-progress form. Not validated."
          }
        },
        "required": [
          "applicationId",
          "draftBody",
          "draftType",
          "sourceSystem",
          "userId"
        ]
      },
      "PriorAuthorityIdResponse": {
        "type": "object",
        "properties": {
          "priorAuthorityId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PriorAuthorityApplicationResponse": {
        "type": "object",
        "description": "Confirmation returned after a prior-authority application has been submitted.",
        "properties": {
          "priorAuthorityId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier assigned to the prior-authority application by the Access Data Store.",
            "example": "11111111-2222-3333-4444-555555555555"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the application was accepted by the Access Data Store.",
            "example": "2026-05-22T10:00:00Z"
          }
        }
      },
      "UploadedDocument": {
        "type": "object",
        "description": "A document uploaded as supporting evidence for a prior-authority request.",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier assigned to the uploaded document by the Access Data Store.",
            "example": "c3b07e24-d92b-410a-9d95-88f117a12b43"
          },
          "documentType": {
            "type": "string",
            "description": "Type of document that was uploaded.",
            "enum": [
              "gateway_evidence",
              "merits_report",
              "statement_of_case",
              "court_application",
              "court_order",
              "expert_report",
              "court_application_or_order",
              "parental_responsibility",
              "local_authority_assessment",
              "grounds_of_appeal",
              "counsel_opinion",
              "judgement",
              "plf_court_order"
            ],
            "example": "GATEWAY_EVIDENCE"
          },
          "fileName": {
            "type": "string",
            "description": "Filename of the uploaded document.",
            "example": "abc123.pdf",
            "minLength": 1
          },
          "fileType": {
            "type": "string",
            "description": "File extension/type of the uploaded document.",
            "example": "pdf"
          },
          "contentType": {
            "type": "string",
            "description": "MIME content type of the uploaded document.",
            "example": "application/pdf"
          },
          "hostedUrl": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Size of the uploaded document, in bytes.",
            "example": 10240
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the document was uploaded.",
            "example": "2026-05-22T10:00:00Z"
          },
          "sourceService": {
            "type": "string",
            "description": "The service that uploaded the document to the Access Data Store.",
            "example": "CIVIL_APPLY"
          },
          "checksum": {
            "type": "string",
            "description": "Checksum of the uploaded document contents."
          }
        },
        "required": [
          "fileName"
        ]
      },
      "DraftCreatedResponse": {
        "type": "object",
        "description": "Confirmation returned after a draft has been created.",
        "properties": {
          "draftId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier assigned to the draft by the Access Data Store.",
            "example": "c3b07e24-d92b-410a-9d95-88f117a12b43"
          }
        }
      },
      "PriorAuthorityResponse": {
        "type": "object",
        "description": "A prior-authority record as returned by the Access Data Store. status is null while the request is still a draft, and PENDING (or later) once it has been submitted.",
        "properties": {
          "priorAuthorityId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the prior-authority request, assigned when it was created.",
            "example": "c3b07e24-d92b-410a-9d95-88f117a12b43"
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "description": "Lifecycle status. null while a draft; e.g. PENDING once submitted.",
            "example": "PENDING"
          },
          "draft": {
            "$ref": "#/components/schemas/PriorAuthorityDraft",
            "description": "The saved prior-authority form."
          }
        }
      },
      "DraftSummary": {
        "type": "object",
        "description": "A single draft returned in a list lookup.",
        "properties": {
          "draftId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the draft.",
            "example": "c3b07e24-d92b-410a-9d95-88f117a12b43"
          },
          "draftType": {
            "type": "string",
            "description": "The form flow this draft belongs to.",
            "example": "PRIOR_AUTHORITY"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the draft was last updated.",
            "example": "2026-05-19T12:00:00Z"
          },
          "draftBody": {
            "type": "object",
            "additionalProperties": {},
            "description": "The JSON payload originally saved by the caller."
          }
        }
      },
      "ApplicationSummary": {
        "type": "object",
        "description": "Summary of a civil application containing key details.",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "The unique reference used to identify the application.",
            "example": "11111111-2222-3333-4444-555555555555"
          },
          "laaReference": {
            "type": "string",
            "description": "The LAA reference number of the application.",
            "example": "LAA-123456"
          },
          "status": {
            "type": "string",
            "description": "The current overall status of the application decision.",
            "example": "APPLICATION_SUBMITTED"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time the application was submitted (in UTC).",
            "example": "2026-07-22T10:00:00Z"
          },
          "clientFirstName": {
            "type": "string",
            "description": "The client first name.",
            "example": "John"
          },
          "clientLastName": {
            "type": "string",
            "description": "The client last name.",
            "example": "Doe"
          },
          "matterType": {
            "type": "string",
            "description": "The matter type of the application.",
            "example": "SPECIAL_CHILDREN_ACT"
          }
        }
      },
      "ApplicationSummaryResponse": {
        "type": "object",
        "description": "Response containing a list of application summaries.",
        "properties": {
          "paging": {
            "$ref": "#/components/schemas/Paging",
            "description": "Pagination metadata for the response."
          },
          "applications": {
            "type": "array",
            "description": "List of application summaries matching the requested criteria.",
            "items": {
              "$ref": "#/components/schemas/ApplicationSummary"
            }
          }
        }
      },
      "Paging": {
        "type": "object",
        "description": "Pagination metadata for a paginated response.",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "The current page number (0-based).",
            "example": 0
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "description": "The number of items per page.",
            "example": 10
          },
          "itemsReturned": {
            "type": "integer",
            "format": "int32",
            "description": "The number of items returned in this page.",
            "example": 10
          },
          "totalRecords": {
            "type": "integer",
            "format": "int32",
            "description": "The total number of records available.",
            "example": 100
          }
        }
      }
    }
  }
}