# Local-only secrets for running with the `local` Spring profile.
# Copy this file to `.env` (which is gitignored) and fill in the real values.
#   cp .env.example .env
# Loaded automatically via `spring.config.import` in application-local.yaml.
# In deployed environments these come from Kubernetes namespace secrets instead

# --- Entra ID Infrastructure ---
AZURE_ENTRA_TENANT_ID=

# --- Civil Manage App Registration (Public IDs) ---
AZURE_ENTRA_API_CLIENT_ID=

# --- Downstream ADS App Registration (Target IDs) ---
ADS_TENANT_DOMAIN=
ADS_CLIENT_ID=

# --- CLIENT SECRET (never commit) ---
AZURE_ENTRA_API_CLIENT_SECRET=
