            "description": "Draft deleted (or did not exist)."
          }
        }
      }
    },
    "/mock-access-data-store/drafts": {
      "get": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "List drafts matching the given keys",
        "operationId": "list",
        "parameters": [
          {
            "name": "sourceSystem",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
