{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Mock Access Data Store — Drafts",
      "description": "Mock of the Access Data Store endpoints that store form drafts."
    },
    {
      "name": "Mock Access Data Store — Prior Authority",
      "description": "Mock of the Access Data Store endpoint that accepts prior-authority submissions."
    }
  ],
  "paths": {
    "/mock-access-data-store/drafts/{draftId}": {
      "get": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "description": "ID of the draft to query.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft returned.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DraftSummary"
                }
              }
            }
          },
          "404": {
            "description": "Draft not found."
          }
        }
      },
      "put": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "Update a draft in the Access Data Store",
        "operationId": "update",
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "description": "ID of the draft to update.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Draft updated."
          },
          "404": {
            "description": "Draft not found."
          }
        }
      },
      "delete": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "Delete a draft from the Access Data Store",
        "operationId": "delete",
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Draft deleted (or did not exist)."
          }
        }
      }
    },
    "/mock-access-data-store/drafts": {
      "get": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "List drafts matching the given keys",
        "operationId": "list",
        "parameters": [
          {
            "name": "sourceSystem",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DraftSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Mock Access Data Store — Drafts"
        ],
        "summary": "Create a draft in the Access Data Store",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Draft created.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed."
          }
        }
      }
    },
    "/mock-access-data-store/applications/{applicationId}/prior-authority": {
      "post": {
        "tags": [
          "Mock Access Data Store — Prior Authority"
        ],
        "summary": "Submit a prior-authority request against an application",
        "description": "Accepts a prior-authority submission for the given application. Repeated submissions for the same applicationId return the same submission ID (idempotent).",
        "operationId": "submit",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "description": "ID of the application this prior-authority request is for.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorAuthoritySubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Submission accepted by the Access Data Store.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PriorAuthorityApplicationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed on the submission body."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Draft": {
        "type": "object",
        "description": "An in-progress draft that the user wants to save and return to later. The draftBody is an unstructured JSON payload owned by the calling system.",
        "properties": {
          "sourceSystem": {
            "type": "string",
            "description": "Identifies the system creating the draft (e.g., laa-civil-manage).",
            "example": "laa-civil-manage",
            "minLength": 1
          },
          "draftType": {
            "type": "string",
            "description": "Identifies the flow the draft belongs to (e.g., PRIOR_AUTHORITY). ",
            "example": "PRIOR_AUTHORITY",
            "minLength": 1
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the application the draft is associated with.",
            "example": "2a28f60d-fe15-43fe-92c3-5530595d5f51"
          },
          "userId": {
            "type": "string",
            "description": "Entra identity of the user who owns the draft.",
            "example": "entra-id-uuid",
            "minLength": 1
          },
          "draftBody": {
            "type": "object",
            "additionalProperties": {},
            "description": "JSON payload representing the in-progress form. Not validated."
          }
        },
        "required": [
          "applicationId",
          "draftBody",
          "draftType",
          "sourceSystem",
          "userId"
        ]
      },
      "DraftCreatedResponse": {
        "type": "object",
        "description": "Confirmation returned after a draft has been created.",
        "properties": {
          "draftId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier assigned to the draft by the Access Data Store.",
            "example": "c3b07e24-d92b-410a-9d95-88f117a12b43"
          }
        }
      },
      "PriorAuthoritySubmission": {
        "type": "object",
        "description": "Prior-authority request body as submitted to the Access Data Store. The applicationId is taken from the URL path; it does not appear in the body.",
        "properties": {
          "priorAuthorityType": {
            "type": "string",
            "description": "The category of prior authority being requested.",
            "enum": [
              "EXPERT",
              "DISBURSEMENT",
              "COUNSEL"
            ],
            "example": "EXPERT"
          },
          "counselType": {
            "type": "string",
            "description": "The counsel type requested. Required when priorAuthorityType is COUNSEL.",
            "enum": [
              "KINGS_COUNSEL_ALONE",
              "TWO_JUNIOR_COUNSEL",
              "KINGS_COUNSEL_AND_JUNIOR_COUNSEL",
              "KINGS_COUNSEL_AND_TWO_JUNIOR_COUNSEL"
            ],
            "example": "KINGS_COUNSEL_ALONE"
          },
          "expertType": {
            "type": "string",
            "description": "The expert type.",
            "example": "Psychologist"
          },
          "expertFullName": {
            "type": "string",
            "description": "Full name of the expert the prior authority is for.",
            "example": "John Doe"
          },
          "expertPostcode": {
            "type": "string",
            "description": "Primary business postcode of the expert.",
            "example": "SW1H 9AJ"
          },
          "expertBasedInLondon": {
            "type": "boolean",
            "description": "Boolean flag to indicate whether the expert is based inside (true) or outside (false) London",
            "example": true
          },
          "uploadedDocuments": {
            "type": "array",
            "description": "Supporting documents uploaded with the request.",
            "items": {
              "$ref": "#/components/schemas/UploadedDocument"
            }
          },
          "billingType": {
            "type": "string",
            "description": "How the work will be billed. Required when priorAuthorityType is EXPERT.",
            "enum": [
              "HOURLY",
              "FIXED_RATE"
            ],
            "example": "HOURLY"
          },
          "hourlyRate": {
            "type": "number",
            "description": "Hourly rate in GBP. Required when billingType is HOURLY.",
            "example": 50.0
          },
          "timeHours": {
            "type": "integer",
            "format": "int32",
            "description": "Estimated whole hours. Required when billingType is HOURLY.",
            "example": 2
          },
          "timeMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "Estimated additional minutes. Required when billingType is HOURLY.",
            "example": 30,
            "maximum": 59,
            "minimum": 0
          },
          "totalAmount": {
            "type": "number",
            "description": "Total amount in GBP.",
            "example": 125.0
          },
          "justification": {
            "type": "string",
            "description": "Detailed rationale explaining why funding is necessary.",
            "example": "Expert evidence is needed to support the claim."
          },
          "counselTypeValid": {
            "type": "boolean"
          },
          "billingTypeValid": {
            "type": "boolean"
          }
        },
        "required": [
          "justification",
          "priorAuthorityType"
        ]
      },
      "UploadedDocument": {
        "type": "object",
        "description": "A document uploaded as supporting evidence for a prior-authority request.",
        "properties": {
          "fileName": {
            "type": "string",
            "description": "Filename of the uploaded document.",
            "example": "abc123.pdf",
            "minLength": 1
          },
          "hostedUrl": {
            "type": "string"
          }
        },
        "required": [
          "fileName"
        ]
      },
      "PriorAuthorityApplicationResponse": {
        "type": "object",
        "description": "Confirmation returned after a prior-authority application has been submitted.",
        "properties": {
          "submissionId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier assigned to the prior-authority application by the Access Data Store.",
            "example": "11111111-2222-3333-4444-555555555555"
          },
          "status": {
            "type": "string",
            "description": "Outcome of the submission.",
            "enum": [
              "ACCEPTED",
              "REJECTED"
            ],
            "example": "ACCEPTED"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the application was accepted by the Access Data Store.",
            "example": "2026-05-22T10:00:00Z"
          }
        }
      },
      "DraftSummary": {
        "type": "object",
        "description": "A single draft returned in a list lookup.",
        "properties": {
          "draftId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the draft.",
            "example": "c3b07e24-d92b-410a-9d95-88f117a12b43"
          },
          "draftType": {
            "type": "string",
            "description": "The form flow this draft belongs to.",
            "example": "PRIOR_AUTHORITY"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp the draft was last updated.",
            "example": "2026-05-19T12:00:00Z"
          },
          "draftBody": {
            "type": "object",
            "additionalProperties": {},
            "description": "The JSON payload originally saved by the caller."
          }
        }
      }
    }
  }
}